@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Reenviar confirmación";
    Layout = "/Views/Shared/_LayoutLogin.cshtml";
}

<div class="login-card">
    <div class="login-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2C9 2 6 4 6 7c0 1.5.4 3 .8 4.5C7.5 14 8 17 8 19c0 1.7 1.3 3 3 3 .8 0 1-.5 1-1.5V19c0-.6.4-1 1-1s1 .4 1 1v1.5c0 1 .2 1.5 1 1.5 1.7 0 3-1.3 3-3 0-2-.5-5-1.2-7.5C17.6 10 18 8.5 18 7c0-3-3-5-6-5z"/>
        </svg>
    </div>
    <div class="login-brand-name">Odontari</div>
    <p class="login-title">Confirmación de correo</p>

    <div class="login-form-surface">
        <div class="login-notice">
            <div class="login-notice-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div class="login-notice-body">
                <p class="login-notice-title">Función no disponible</p>
                <p class="login-notice-text">El reenvío de confirmación por correo electrónico no está habilitado. Contacte al administrador de su clínica para gestionar el acceso.</p>
            </div>
        </div>
        <a asp-page="./Login" class="login-submit" style="text-decoration:none;display:block;text-align:center;line-height:2.6">
            Volver al inicio de sesión
        </a>
    </div>
</div>
