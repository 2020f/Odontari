@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "/Views/Shared/_LayoutLogin.cshtml";
}

<div class="login-card">
    <div class="login-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2C9 2 6 4 6 7c0 1.5.4 3 .8 4.5C7.5 14 8 17 8 19c0 1.7 1.3 3 3 3 .8 0 1-.5 1-1.5V19c0-.6.4-1 1-1s1 .4 1 1v1.5c0 1 .2 1.5 1 1.5 1.7 0 3-1.3 3-3 0-2-.5-5-1.2-7.5C17.6 10 18 8.5 18 7c0-3-3-5-6-5z"/>
        </svg>
    </div>
    <div class="login-brand-name">Odontari</div>
    <p class="login-title">Recuperar acceso</p>

    <div class="login-form-surface">
        <div class="login-notice">
            <div class="login-notice-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <div class="login-notice-body">
                <p class="login-notice-title">Recuperación no disponible</p>
                <p class="login-notice-text">El restablecimiento de contraseña por correo no está habilitado. Contacte al administrador de su clínica para que le asigne una nueva contraseña.</p>
            </div>
        </div>
        <a asp-page="./Login" class="login-submit" style="text-decoration:none;display:block;text-align:center;line-height:2.6">
            Volver al inicio de sesión
        </a>
    </div>
</div>
