@using Odontari.Web.Models.Enums
@using Odontari.Web.ViewModels
@using System.Globalization
@{
    ViewData["Title"] = "Panel de Control";
    var citasHoy         = ViewBag.CitasHoy as IList<Odontari.Web.Models.Cita> ?? new List<Odontari.Web.Models.Cita>();
    var pendientesCobro  = ViewBag.PendientesCobro as IList<Odontari.Web.Models.OrdenCobro> ?? new List<Odontari.Web.Models.OrdenCobro>();
    var doctoresStatus   = ViewBag.DoctoresStatus as IList<DoctorStatusViewModel>;
    var citasManana      = ViewBag.CitasManana as IList<Odontari.Web.Models.Cita>;
    var esRecepcion      = User.IsInRole("Recepcion") || User.IsInRole("AdminClinica");

    var ci        = CultureInfo.GetCultureInfo("es-ES");
    var hoy       = DateTime.Today;
    var manana    = hoy.AddDays(1);
    var nombreDia = ci.DateTimeFormat.GetDayName(hoy.DayOfWeek);
    var nombreMes = ci.DateTimeFormat.GetMonthName(hoy.Month);
    var diaManana = ci.DateTimeFormat.GetDayName(manana.DayOfWeek);
    var mesMana   = ci.DateTimeFormat.GetMonthName(manana.Month);
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page">
    <div class="dashboard-header">
        <h1>Panel de Control</h1>
        <p class="dashboard-date">@(char.ToUpper(nombreDia[0]) + nombreDia.Substring(1)), @hoy.Day de @nombreMes de @hoy.Year</p>
    </div>

    <div class="dashboard-metrics">
        @* Citas hoy — Azul *@
        <div class="dashboard-metric-card metric-citas">
            <div class="mc-body">
                <div class="mc-icon-pill">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <div class="mc-center">
                    <span class="mc-label">Citas hoy</span>
                    <p class="mc-value">@citasHoy.Count</p>
                </div>
            </div>
            <div class="mc-ghost" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <a asp-controller="Agenda" asp-action="Index" asp-route-fecha="@hoy" class="mc-footer">
                <div class="mc-footer-circle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <span class="mc-footer-text">Ver agenda de hoy</span>
                <span class="mc-footer-arrow">›</span>
            </a>
        </div>
        @* Pendientes de cobro — Verde *@
        <div class="dashboard-metric-card metric-cobro">
            <div class="mc-body">
                <div class="mc-icon-pill">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div class="mc-center">
                    <span class="mc-label">Pendientes de cobro</span>
                    <p class="mc-value">@pendientesCobro.Count</p>
                </div>
            </div>
            <div class="mc-ghost" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <a asp-controller="Caja" asp-action="Index" class="mc-footer">
                <div class="mc-footer-circle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <span class="mc-footer-text">Ir a caja</span>
                <span class="mc-footer-arrow">›</span>
            </a>
        </div>
        @if (esRecepcion && citasManana != null)
        {
            @* Citas mañana — Naranja *@
            <div class="dashboard-metric-card metric-manana">
                <div class="mc-body">
                    <div class="mc-icon-pill">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16l2 2 4-4"/></svg>
                    </div>
                    <div class="mc-center">
                        <span class="mc-label">Citas mañana</span>
                        <p class="mc-value">@citasManana.Count</p>
                    </div>
                </div>
                <div class="mc-ghost" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16l2 2 4-4"/></svg>
                </div>
                <a asp-controller="Agenda" asp-action="Index" asp-route-fecha="@manana" class="mc-footer">
                    <div class="mc-footer-circle">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16l2 2 4-4"/></svg>
                    </div>
                    <span class="mc-footer-text">Ver agenda de mañana</span>
                    <span class="mc-footer-arrow">›</span>
                </a>
            </div>
        }
        @if (esRecepcion && doctoresStatus != null)
        {
            var libres   = doctoresStatus.Count(d => d.Estado == DoctorEstado.Libre);
            var ocupados = doctoresStatus.Count(d => d.Estado == DoctorEstado.Ocupado);
            @* Doctores activos — Morado *@
            <div class="dashboard-metric-card metric-doctor">
                <div class="mc-body">
                    <div class="mc-icon-pill">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <div class="mc-center">
                        <span class="mc-label">Doctores activos</span>
                        <p class="mc-value">@libres <span class="mc-value-sub">libres</span></p>
                        @if (ocupados > 0)
                        {
                            <div class="metric-badge-ocupado">@ocupados en atención</div>
                        }
                    </div>
                </div>
                <div class="mc-ghost" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div class="mc-footer">
                    <div class="mc-footer-circle">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <span class="mc-footer-text">Estado en tiempo real</span>
                    <span class="mc-footer-arrow">›</span>
                </div>
            </div>
        }
    </div>

    @* Tarjetas principales *@
    <div class="dashboard-cards">
        <div class="dashboard-card">
            <div class="card-header">
                <h2>Próximas citas</h2>
                <a asp-controller="Agenda" asp-action="Index" asp-route-fecha="@hoy">Ver agenda</a>
                <a asp-controller="Agenda" asp-action="Create" asp-route-fechaHora="@hoy.AddHours(9)">Nueva cita</a>
            </div>
            <div class="card-body">
                @if (citasHoy.Any())
                {
                    @foreach (var c in citasHoy)
                    {
                        var inicial = (c.Paciente?.Nombre ?? "?").Length > 0 ? char.ToUpperInvariant((c.Paciente?.Nombre ?? "?")[0]).ToString() : "?";
                        var estadoNombre = c.Estado switch
                        {
                            EstadoCita.Solicitada  => "Pendiente",
                            EstadoCita.Confirmada  => "Confirmada",
                            EstadoCita.EnSala      => "En sala",
                            EstadoCita.EnAtencion  => "En atención",
                            EstadoCita.Finalizada  => "Finalizada",
                            _                      => c.Estado.ToString()
                        };
                        <div class="dashboard-list-item">
                            <div class="avatar">@inicial</div>
                            <div class="body">
                                <div class="title">@(c.Paciente?.Nombre) @(c.Paciente?.Apellidos)</div>
                                <div class="sub">@(c.Motivo ?? "Consulta") · @estadoNombre</div>
                            </div>
                            <span class="hora">@c.FechaHora.ToString("HH:mm")</span>
                            <a asp-controller="Agenda" asp-action="Index" asp-route-fecha="@c.FechaHora.Date" class="btn-link">Ver</a>
                        </div>
                    }
                }
                else
                {
                    <div class="dashboard-empty">No hay citas hoy. <a asp-controller="Agenda" asp-action="Create" asp-route-fechaHora="@hoy.AddHours(9)" style="color:var(--odon-accent);">Crear cita</a></div>
                }
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-header">
                <h2>Pendientes de cobro</h2>
                <a asp-controller="Caja" asp-action="Index">Ir a Caja</a>
            </div>
            <div class="card-body">
                @if (pendientesCobro.Any())
                {
                    @foreach (var o in pendientesCobro)
                    {
                        var pendiente = o.Total - o.MontoPagado;
                        var inicial = (o.Paciente?.Nombre ?? "?").Length > 0 ? char.ToUpperInvariant((o.Paciente?.Nombre ?? "?")[0]).ToString() : "?";
                        <div class="dashboard-list-item">
                            <div class="avatar">@inicial</div>
                            <div class="body">
                                <div class="title">@(o.Paciente?.Nombre) @(o.Paciente?.Apellidos)</div>
                                <div class="sub">Orden #@o.Id</div>
                            </div>
                            <span class="monto">RD$ @pendiente.ToString("N2")</span>
                            <a asp-controller="Caja" asp-action="Cobrar" asp-route-id="@o.Id" class="btn-link">Cobrar</a>
                        </div>
                    }
                }
                else
                {
                    <div class="dashboard-empty">No hay órdenes pendientes de cobro.</div>
                }
            </div>
        </div>
    </div>

    @* Panel Recepción: Estado doctores + Citas mañana *@
    @if (esRecepcion)
    {
        <div class="dashboard-recepcion-row">

            @* Tarjeta: Estado de doctores *@
            <div class="dashboard-card">
                <div class="card-header">
                    <h2>Estado de doctores</h2>
                    <span class="card-header-chip">Tiempo real</span>
                </div>
                <div class="card-body">
                    @if (doctoresStatus != null && doctoresStatus.Any())
                    {
                        @foreach (var doc in doctoresStatus)
                        {
                            var inicial = doc.NombreCompleto.Length > 0 ? char.ToUpperInvariant(doc.NombreCompleto[0]).ToString() : "?";
                            var estadoClass = doc.Estado switch
                            {
                                DoctorEstado.Ocupado         => "ds-ocupado",
                                DoctorEstado.FueraDeHorario  => "ds-fuera",
                                _                            => "ds-libre"
                            };
                            var estadoLabel = doc.Estado switch
                            {
                                DoctorEstado.Ocupado        => "En atención",
                                DoctorEstado.FueraDeHorario => "Fuera de horario",
                                _                           => "Libre"
                            };
                            <div class="dashboard-doctor-item">
                                <div class="doctor-avatar">@inicial</div>
                                <div class="doctor-info">
                                    <div class="doctor-name">@doc.NombreCompleto</div>
                                    @if (doc.Estado == DoctorEstado.Ocupado && doc.PacienteActual != null)
                                    {
                                        <div class="doctor-sub">@doc.PacienteActual</div>
                                    }
                                    else if (doc.ProximaCitaTexto != null)
                                    {
                                        <div class="doctor-sub">Próx. @doc.ProximaCitaTexto</div>
                                    }
                                    else if (doc.HorarioTexto != null)
                                    {
                                        <div class="doctor-sub">@doc.HorarioTexto</div>
                                    }
                                </div>
                                <span class="doctor-status-badge @estadoClass">@estadoLabel</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="dashboard-empty">No hay doctores activos registrados.</div>
                    }
                </div>
            </div>

            @* Tarjeta: Citas de mañana *@
            <div class="dashboard-card">
                <div class="card-header">
                    <h2>Citas de mañana</h2>
                    <span class="card-header-date">@(char.ToUpper(diaManana[0]) + diaManana.Substring(1)) @manana.Day de @mesMana</span>
                    <a asp-controller="Agenda" asp-action="Index" asp-route-fecha="@manana">Ver agenda</a>
                </div>
                <div class="card-body">
                    @if (citasManana != null && citasManana.Any())
                    {
                        @foreach (var c in citasManana)
                        {
                            var inicial = (c.Paciente?.Nombre ?? "?").Length > 0 ? char.ToUpperInvariant((c.Paciente?.Nombre ?? "?")[0]).ToString() : "?";
                            var doctorNombre = c.Doctor?.NombreCompleto ?? c.Doctor?.Email ?? "—";
                            <div class="dashboard-list-item">
                                <div class="avatar">@inicial</div>
                                <div class="body">
                                    <div class="title">@(c.Paciente?.Nombre) @(c.Paciente?.Apellidos)</div>
                                    <div class="sub">@(c.Motivo ?? "Consulta") · Dr. @doctorNombre</div>
                                </div>
                                <span class="hora">@c.FechaHora.ToString("HH:mm")</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="dashboard-empty">No hay citas agendadas para mañana. <a asp-controller="Agenda" asp-action="Create" asp-route-fechaHora="@manana.AddHours(9)" style="color:var(--odon-accent);">Crear cita</a></div>
                    }
                </div>
            </div>

        </div>
    }
</div>

@if (ViewBag.MostrarAccesoDenegado == true)
{
    @await Html.PartialAsync("_AccesoDenegadoOverlay")
}
