@model PersonalEditViewModel
@{
    ViewData["Title"] = "Editar usuario";
    var roles = new[] { Odontari.Web.Data.OdontariRoles.Recepcion, Odontari.Web.Data.OdontariRoles.Doctor, Odontari.Web.Data.OdontariRoles.Finanzas, Odontari.Web.Data.OdontariRoles.AdminClinica };
}

<div class="odon-form-page-wide">
    <div class="odon-form-header">
        <h1 class="odon-form-title">Editar usuario</h1>
        <a asp-area="Clinica" asp-controller="Personal" asp-action="Index" class="odon-form-back">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Volver
        </a>
    </div>

    <div class="odon-form-card">
        <form asp-area="Clinica" asp-controller="Personal" asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="odon-form-body">

                <p class="odon-section-label">Datos del usuario</p>

                <div class="odon-form-field">
                    <label asp-for="NombreCompleto" class="odon-label"></label>
                    <input asp-for="NombreCompleto" class="odon-input" />
                    <span asp-validation-for="NombreCompleto" class="odon-error-msg"></span>
                </div>

                <div class="odon-form-row">
                    <div class="odon-form-field">
                        <label asp-for="Email" class="odon-label"></label>
                        <input asp-for="Email" class="odon-input" readonly />
                        <span class="odon-hint">El email no puede modificarse.</span>
                    </div>
                    <div class="odon-form-field">
                        <label asp-for="NuevaPassword" class="odon-label"></label>
                        <input asp-for="NuevaPassword" class="odon-input" type="password" placeholder="Dejar en blanco para no cambiar" />
                    </div>
                </div>

                <div class="odon-form-row">
                    <div class="odon-form-field">
                        <label asp-for="Rol" class="odon-label"></label>
                        <select asp-for="Rol" class="odon-select">
                            @foreach (var r in roles)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                        <span asp-validation-for="Rol" class="odon-error-msg"></span>
                    </div>
                    <div></div>
                </div>

                <div class="odon-form-divider"></div>

                <p class="odon-section-label">Horario laboral <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:0.78rem;color:rgba(0,29,57,0.38)">(solo doctores)</span></p>

                <div class="odon-form-row" id="horarioLaboralGroup">
                    <div class="odon-form-field">
                        <label asp-for="HoraEntrada" class="odon-label">Hora de entrada</label>
                        <input asp-for="HoraEntrada" class="odon-input" type="time" />
                    </div>
                    <div class="odon-form-field">
                        <label asp-for="HoraSalida" class="odon-label">Hora de salida</label>
                        <input asp-for="HoraSalida" class="odon-input" type="time" />
                    </div>
                </div>
                <span class="odon-hint" style="display:block;margin-top:-0.5rem;margin-bottom:1rem;">Ej. 08:00 a 17:00.</span>

                <label class="odon-check-row">
                    <input asp-for="Activo" class="odon-check-input" />
                    <span class="odon-check-label">Usuario activo</span>
                </label>

                <div class="odon-form-divider"></div>

                <p class="odon-section-label">Permisos de vistas</p>
                <p class="odon-hint" style="margin-bottom:1.25rem;margin-top:-0.75rem;">
                    <strong style="color:#1a2e3f;">ON</strong> = puede ver el módulo. <strong style="color:#1a2e3f;">OFF</strong> = bloqueado para este usuario. Si todos están ON, no hay restricción.
                </p>

                <div class="odon-permisos-section">
                    <div class="odon-permisos-group">
                        <p class="odon-permisos-subtitle">Navegación principal</p>
                        <div class="odon-permisos-grid">
                            @if (Model.PermisosVistas != null)
                            {
                                for (var i = 0; i < Model.PermisosVistas.Count && i < 5; i++)
                                {
                                    var p = Model.PermisosVistas[i];
                                    var nombreVista = p.Nombre ?? p.VistaKey ?? "Vista";
                                    <div class="odon-permiso-item">
                                        <input type="hidden" asp-for="PermisosVistas[i].VistaKey" />
                                        <input type="hidden" asp-for="PermisosVistas[i].Nombre" />
                                        <label class="odon-toggle-label">
                                            <span class="odon-toggle-name" title="@nombreVista">@nombreVista</span>
                                            <span class="odon-toggle-wrap">
                                                <input type="checkbox" asp-for="PermisosVistas[i].Permitido" class="odon-toggle-input" value="true" />
                                                <span class="odon-toggle-slider"></span>
                                            </span>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="odon-permisos-group">
                        <p class="odon-permisos-subtitle">Operaciones, cobros y reportes</p>
                        <div class="odon-permisos-grid">
                            @if (Model.PermisosVistas != null)
                            {
                                for (var i = 5; i < Model.PermisosVistas.Count; i++)
                                {
                                    var p = Model.PermisosVistas[i];
                                    var nombreVista = p.Nombre ?? p.VistaKey ?? "Vista";
                                    <div class="odon-permiso-item">
                                        <input type="hidden" asp-for="PermisosVistas[i].VistaKey" />
                                        <input type="hidden" asp-for="PermisosVistas[i].Nombre" />
                                        <label class="odon-toggle-label">
                                            <span class="odon-toggle-name" title="@nombreVista">@nombreVista</span>
                                            <span class="odon-toggle-wrap">
                                                <input type="checkbox" asp-for="PermisosVistas[i].Permitido" class="odon-toggle-input" value="true" />
                                                <span class="odon-toggle-slider"></span>
                                            </span>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

            </div>
            <div class="odon-form-footer">
                <button type="submit" class="odon-btn odon-btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Guardar cambios
                </button>
                <a asp-area="Clinica" asp-controller="Personal" asp-action="Index" class="odon-btn odon-btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
