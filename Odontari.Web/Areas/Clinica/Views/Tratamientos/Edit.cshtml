@model TratamientoEditViewModel
@{
    ViewData["Title"] = "Editar tratamiento";
}

<div class="odon-form-page">
    <div class="odon-form-header">
        <h1 class="odon-form-title">Editar tratamiento</h1>
        <a asp-action="Index" class="odon-form-back">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Volver
        </a>
    </div>

    <div class="odon-form-card">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="odon-form-body">

                <p class="odon-section-label">Datos del tratamiento</p>

                <div class="odon-form-row">
                    <div class="odon-form-field">
                        <label asp-for="Nombre" class="odon-label"></label>
                        <input asp-for="Nombre" class="odon-input" />
                        <span asp-validation-for="Nombre" class="odon-error-msg"></span>
                    </div>
                    <div class="odon-form-field">
                        <label asp-for="Categoria" class="odon-label"></label>
                        <input asp-for="Categoria" class="odon-input" />
                        <span asp-validation-for="Categoria" class="odon-error-msg"></span>
                    </div>
                </div>

                <div class="odon-form-row">
                    <div class="odon-form-field">
                        <label asp-for="PrecioBase" class="odon-label"></label>
                        <input asp-for="PrecioBase" type="number" step="0.01" class="odon-input" />
                        <span asp-validation-for="PrecioBase" class="odon-error-msg"></span>
                    </div>
                    <div class="odon-form-field">
                        <label asp-for="DuracionMinutos" class="odon-label"></label>
                        <input asp-for="DuracionMinutos" type="number" class="odon-input" />
                        <span asp-validation-for="DuracionMinutos" class="odon-error-msg"></span>
                    </div>
                </div>

                <label class="odon-check-row">
                    <input asp-for="Activo" class="odon-check-input" />
                    <span class="odon-check-label">Tratamiento activo</span>
                </label>

            </div>
            <div class="odon-form-footer">
                <button type="submit" class="odon-btn odon-btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Guardar cambios
                </button>
                <a asp-action="Index" class="odon-btn odon-btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
