@model IEnumerable<TratamientoListViewModel>
@{
    ViewData["Title"] = "Tratamientos";
}

<div class="content-header">
    <h1>Catálogo de tratamientos</h1>
    <a asp-action="Create" class="btn-content-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nuevo tratamiento
    </a>
</div>

<div class="content-card">
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Duración</th>
                <th>Categoría</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Nombre</td>
                    <td>RD$ @t.PrecioBase.ToString("N2")</td>
                    <td>@t.DuracionMinutos min</td>
                    <td>@t.Categoria</td>
                    <td>
                        @if (t.Activo)
                        {
                            <span class="odon-badge odon-badge-active">Activo</span>
                        }
                        else
                        {
                            <span class="odon-badge odon-badge-inactive">Inactivo</span>
                        }
                    </td>
                    <td>
                        <div class="tbl-actions-cell">
                            <a asp-action="Edit" asp-route-id="@t.Id" class="tbl-action tbl-action-edit">Editar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="content-empty">
            No hay tratamientos registrados.
            <a asp-action="Create" style="color:var(--odon-accent);font-weight:600;">Crear el primero</a>
        </div>
    }
</div>
