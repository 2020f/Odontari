@model IEnumerable<PacienteListViewModel>
@{
    ViewData["Title"] = "Pacientes";
}

<div class="content-header">
    <h1>Pacientes</h1>
    <a asp-action="Create" class="btn-content-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nuevo paciente
    </a>
</div>

<form method="get" class="search-bar">
    <input type="text" name="q" value="@Context.Request.Query["q"]"
           placeholder="Buscar nombre, cédula, teléfono…"
           class="search-input" />
    <button type="submit" class="btn-search">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        Buscar
    </button>
</form>

<div class="content-card">
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cédula</th>
                <th>Teléfono</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Nombre @p.Apellidos</td>
                    <td>@p.Cedula</td>
                    <td>@p.Telefono</td>
                    <td>
                        @if (p.Activo)
                        {
                            <span class="odon-badge odon-badge-active">Activo</span>
                        }
                        else
                        {
                            <span class="odon-badge odon-badge-inactive">Inactivo</span>
                        }
                    </td>
                    <td>
                        <div class="tbl-actions-cell">
                            <a asp-controller="Expediente" asp-action="Index" asp-route-id="@p.Id" class="tbl-action tbl-action-view">Expediente</a>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="tbl-action tbl-action-edit">Editar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="content-empty">
            No hay pacientes registrados.
            <a asp-action="Create" style="color:var(--odon-accent);font-weight:600;">Crear el primero</a>
        </div>
    }
</div>
