@model Odontari.Web.ViewModels.HistogramaViewModel
@{
    var paciente = ViewBag.Paciente as Odontari.Web.Models.Paciente;
    ViewData["Title"] = "Histograma - " + Model.Nombre;
    var edad = Model.FechaNacimiento.HasValue ? (DateTime.Today.Year - Model.FechaNacimiento.Value.Year) : (int?)null;
    var fi = ViewBag.FechaInicio as DateTime?;
    var ff = ViewBag.FechaFin as DateTime?;
}
@section Styles {
    <link rel="stylesheet" href="~/css/histograma.css" asp-append-version="true" />
}

@await Html.PartialAsync("_ExpedienteMenu")

@* Tarjeta de paciente *@
<div class="histograma-patient-card content-card mb-4">
    <div class="histograma-patient-info">
        <div class="histograma-patient-avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div class="histograma-patient-meta">
            <h1 class="histograma-patient-name">@Model.Nombre @Model.Apellidos</h1>
            @if (edad.HasValue)
            {
                <p class="histograma-patient-detail">
                    <span class="histograma-detail-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
                    @edad años
                </p>
            }
            <p class="histograma-patient-detail">
                <span class="histograma-detail-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
                @(Model.Telefono ?? Model.Cedula ?? "—")
            </p>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Model.Alergias))
    {
        <div class="histograma-allergy-alert">
            <span class="histograma-allergy-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>
            <span>@Model.Alergias</span>
        </div>
    }
</div>

@* Datos del paciente *@
<div class="histo-section mb-4">
    <div class="histo-section-head">
        <h3 class="histo-section-title">Datos del paciente</h3>
    </div>
    <div class="histo-section-body">
        <div class="histo-data-grid">
            <div>
                <div class="histo-data-label">Nombre completo</div>
                <div class="histo-data-value">@Model.Nombre @Model.Apellidos</div>
            </div>
            <div>
                <div class="histo-data-label">Documento / Cédula</div>
                <div class="histo-data-value">@(Model.Cedula ?? "—")</div>
            </div>
            <div>
                <div class="histo-data-label">Contacto</div>
                <div class="histo-data-value">@(Model.Telefono ?? Model.Email ?? "—")</div>
            </div>
            <div>
                <div class="histo-data-label">Alergias</div>
                <div class="histo-data-value">
                    @if (Model.HistoriaClinicaSistematica?.AlergiasMedicamentos == true && !string.IsNullOrWhiteSpace(Model.HistoriaClinicaSistematica.AlergiasCuales))
                    {
                        @Model.HistoriaClinicaSistematica.AlergiasCuales
                    }
                    else
                    {
                        @(Model.Alergias ?? "Ninguna registrada")
                    }
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.NotasClinicas))
            {
                <div style="grid-column: 1 / -1;">
                    <div class="histo-data-label">Notas clínicas</div>
                    <div class="histo-data-value">@Model.NotasClinicas</div>
                </div>
            }
        </div>

        @if (Model.HistoriaClinicaSistematica?.TieneDatos == true)
        {
            var h = Model.HistoriaClinicaSistematica;
            var condiciones = new List<(string Nombre, bool? Val, string? Detalle)>
            {
                ("Alergias a medicamentos / anestésicos", h.AlergiasMedicamentos, h.AlergiasCuales),
                ("Asma bronquial",                        h.AsmaBronquial,          null),
                ("Convulsiones / Epilepsia",              h.ConvulsionesEpilepsia,  null),
                ("Diabetes",                              h.Diabetes,               null),
                ("Enfermedades cardíacas",                h.EnfermedadesCardiacas,  null),
                ("Embarazo",                              h.Embarazo,               h.EmbarazoSemanas.HasValue ? h.EmbarazoSemanas + " semanas" : null),
                ("Enfermedades venéreas / SIDA",          h.EnfermedadesVenereas,   null),
                ("Fiebre reumática",                      h.FiebreReumatica,        null),
                ("Hepatitis",                             h.Hepatitis,              h.HepatitisCual),
                ("Problemas neurológicos",                h.ProblemasNeurologicos,  null),
                ("Problemas renales",                     h.ProblemasRenales,       null),
                ("Problemas sinusales",                   h.ProblemasSinusales,     null),
                ("Sangrado excesivo",                     h.SangradoExcesivo,       null),
                ("Trastornos psiquiátricos",              h.TrastornosPsiquiatricos,null),
                ("Trastornos digestivos",                 h.TrastornosDigestivos,   null),
                ("Tumores benignos / malignos",           h.TumoresBenignosMalignos,h.TumoresCuales),
                ("Trastornos respiratorios",              h.TrastornosRespiratorios,h.TrastornosRespiratoriosCuales),
            };

            <div class="histo-subsection">
                <div class="histo-subsection-head">
                    <div class="histo-data-label" style="margin:0;">Antecedentes médicos</div>
                    <a asp-action="HistoriaClinicaSistematica" asp-route-id="@Model.PacienteId" class="histo-tl-action">Editar</a>
                </div>
                <div class="histo-conditions">
                    @foreach (var (nombre, val, detalle) in condiciones)
                    {
                        var esPos = val == true;
                        <div class="histo-condition @(esPos ? "histo-condition-yes" : "histo-condition-no")">
                            <div class="histo-condition-dot"></div>
                            <div class="histo-condition-name">
                                @nombre
                                @if (esPos && !string.IsNullOrWhiteSpace(detalle))
                                {
                                    <span style="font-weight:400;color:#64748b;"> — @detalle</span>
                                }
                            </div>
                            <div class="histo-condition-val">@(val == true ? "Sí" : val == false ? "No" : "—")</div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="histo-subsection">
                <a asp-action="HistoriaClinicaSistematica" asp-route-id="@Model.PacienteId" class="histo-tl-action">
                    Completar historia clínica sistemática
                </a>
            </div>
        }
    </div>
</div>

@* Resumen odontograma *@
<div class="histo-section mb-4">
    <div class="histo-section-head">
        <h3 class="histo-section-title">Resumen odontograma</h3>
        @if (Model.ResumenOdontograma != null)
        {
            <span style="font-size:.72rem;color:#94a3b8;">Actualizado: @(Model.ResumenOdontograma.UltimaActualizacion?.ToString("dd/MM/yyyy") ?? "—")</span>
        }
    </div>
    <div class="histo-section-body">
        @if (Model.ResumenOdontograma != null)
        {
            var r = Model.ResumenOdontograma;
            <div class="histo-stats-grid">
                <div class="histo-stat histo-stat-caries">
                    <div class="histo-stat-num">@r.Caries</div>
                    <div class="histo-stat-label">Caries</div>
                </div>
                <div class="histo-stat histo-stat-rest">
                    <div class="histo-stat-num">@r.Restauraciones</div>
                    <div class="histo-stat-label">Restauraciones</div>
                </div>
                <div class="histo-stat histo-stat-ausentes">
                    <div class="histo-stat-num">@r.Ausentes</div>
                    <div class="histo-stat-label">Ausentes</div>
                </div>
                <div class="histo-stat histo-stat-endo">
                    <div class="histo-stat-num">@r.Endodoncia</div>
                    <div class="histo-stat-label">Endodoncia</div>
                </div>
                <div class="histo-stat histo-stat-otros">
                    <div class="histo-stat-num">@r.Otros</div>
                    <div class="histo-stat-label">Otros</div>
                </div>
            </div>

            @if (r.UltimosDientesConHallazgo.Any())
            {
                <div class="histo-data-label mb-1">Dientes con hallazgo</div>
                <div style="font-size:.875rem;color:#1e293b;font-weight:500;margin-bottom:.75rem;">
                    @string.Join(", ", r.UltimosDientesConHallazgo)
                </div>
            }

            @if (r.ListaHallazgos.Any())
            {
                <div class="histo-data-label mb-1">Lista de hallazgos</div>
                <div class="histo-hallazgos">
                    @foreach (var hallazgo in r.ListaHallazgos)
                    {
                        <div>@hallazgo</div>
                    }
                </div>
            }
        }
        else
        {
            <p style="color:#94a3b8;font-size:.875rem;margin:0;">
                No hay odontograma registrado.
                <a asp-action="Odontograma" asp-route-id="@Model.PacienteId" style="color:#4E8EA2;font-weight:600;">Abrir odontograma</a>
            </p>
        }
    </div>
</div>

@* Resumen rápido *@
<div class="histo-section mb-4">
    <div class="histo-section-head">
        <h3 class="histo-section-title">@(Model.UltimoDiagnosticoEsPeriodontograma ? "Resumen del periodontograma" : "Resumen rápido")</h3>
    </div>
    <div class="histo-section-body">
        <div class="histo-summary-grid">
            <div>
                <div class="histo-summary-label">Última visita</div>
                <div class="histo-summary-value">@(Model.UltimaVisita ?? "Sin registros")</div>
            </div>
            <div>
                <div class="histo-summary-label">@(Model.UltimoDiagnosticoEsPeriodontograma ? "Hallazgos del periodontograma" : "Último diagnóstico / procedimiento")</div>
                <div class="histo-summary-value">
                    @if (!string.IsNullOrEmpty(Model.UltimoDiagnostico))
                    {
                        @Html.Raw(System.Net.WebUtility.HtmlEncode(Model.UltimoDiagnostico).Replace("\n", "<br/>"))
                    }
                    else
                    {
                        <span style="color:#94a3b8;">—</span>
                    }
                </div>
            </div>
            <div>
                <div class="histo-summary-label">Próximo paso</div>
                <div class="histo-summary-value">@(Model.ProximoPaso ?? "Ninguno programado")</div>
            </div>
        </div>
    </div>
</div>

@* Timeline *@
@{
    var esDoctor = User.IsInRole(Odontari.Web.Data.OdontariRoles.Doctor) || User.IsInRole(Odontari.Web.Data.OdontariRoles.AdminClinica);
}
<div class="histo-section mb-4">
    <div class="histo-section-head">
        <h3 class="histo-section-title">Timeline (histórico)</h3>
        <a href="@Url.Action("ExportarHistogramaPdf", new { id = Model.PacienteId, fechaInicio = fi, fechaFin = ff })"
           class="histo-tl-action" target="_blank" rel="noopener">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Exportar PDF
        </a>
    </div>

    @* Formulario de nota clínica — solo Doctor/AdminClinica *@
    @if (esDoctor)
    {
        <div class="histo-nota-form-wrap">
            <form asp-action="AgregarNotaClinica" asp-controller="Expediente" asp-area="Clinica" method="post" class="histo-nota-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pacienteId" value="@Model!.PacienteId" />
                <div class="histo-nota-form-body">
                    <svg class="histo-nota-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    <textarea name="nota" class="histo-nota-textarea" rows="2"
                              placeholder="Agregar nota clínica para este paciente…" maxlength="2000" required></textarea>
                </div>
                <div class="histo-nota-form-footer">
                    <span class="histo-nota-hint">La nota quedará firmada con tu nombre y fecha.</span>
                    <button type="submit" class="histo-nota-btn">Guardar nota</button>
                </div>
            </form>
        </div>
    }

    <div class="histo-filter-bar">
        <form asp-action="Histograma" method="get" class="histo-filter-form">
            <input type="hidden" name="id" value="@Model.PacienteId" />
            @if (ViewBag.CitaId != null) { <input type="hidden" name="citaId" value="@ViewBag.CitaId" /> }
            <span class="histo-filter-label">Desde</span>
            <input type="date" name="fechaInicio" value="@(fi?.ToString("yyyy-MM-dd") ?? "")" class="form-control form-control-sm" style="width:auto;" />
            <span class="histo-filter-label">Hasta</span>
            <input type="date" name="fechaFin" value="@(ff?.ToString("yyyy-MM-dd") ?? "")" class="form-control form-control-sm" style="width:auto;" />
            <button type="submit" class="histo-tl-action">Filtrar</button>
        </form>
        @if (fi.HasValue || ff.HasValue)
        {
            <span class="histo-active-filter">
                @(fi.HasValue ? $"desde {fi.Value:dd/MM/yyyy}" : "")
                @(ff.HasValue ? $"hasta {ff.Value:dd/MM/yyyy}" : "")
            </span>
        }
    </div>

    <div class="histo-section-body">
        @if (Model.Timeline.Any())
        {
            <div class="histo-timeline-list">
                @foreach (var ev in Model.Timeline)
                {
                    var tipo = ev.TipoEvento ?? "";
                    var esOdonto      = tipo.Contains("odontograma", StringComparison.OrdinalIgnoreCase) ||
                                        tipo.Contains("periodontograma", StringComparison.OrdinalIgnoreCase);
                    var esPago        = tipo.Contains("pago", StringComparison.OrdinalIgnoreCase) ||
                                        tipo.Contains("cobro", StringComparison.OrdinalIgnoreCase);
                    var esNotaClinica = tipo.Equals("Nota clínica", StringComparison.OrdinalIgnoreCase);
                    var esNotaRecep   = tipo.Equals("Nota de recepción", StringComparison.OrdinalIgnoreCase);

                    var dotClass = esOdonto      ? "histo-tl-dot histo-tl-dot-odonto"
                                 : esPago        ? "histo-tl-dot histo-tl-dot-pago"
                                 : esNotaClinica ? "histo-tl-dot histo-tl-dot-nota"
                                 : esNotaRecep   ? "histo-tl-dot histo-tl-dot-recep"
                                 :                 "histo-tl-dot histo-tl-dot-cita";
                    var typeClass = esOdonto      ? "histo-tl-type histo-tl-type-odonto"
                                  : esPago        ? "histo-tl-type histo-tl-type-pago"
                                  : esNotaClinica ? "histo-tl-type histo-tl-type-nota"
                                  : esNotaRecep   ? "histo-tl-type histo-tl-type-recep"
                                  :                 "histo-tl-type histo-tl-type-cita";

                    <div class="histo-tl-item @(esNotaClinica || esNotaRecep ? "histo-tl-item-nota" : "")">
                        <div class="@dotClass"></div>
                        <div class="histo-tl-head">
                            <span class="histo-tl-date">@ev.FechaEvento.ToString("dd/MM/yyyy HH:mm")</span>
                            <span class="@typeClass">@tipo</span>
                        </div>
                        @if (!string.IsNullOrEmpty(ev.AutorNombre))
                        {
                            <div class="histo-tl-autor">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                @ev.AutorNombre
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(ev.Descripcion))
                        {
                            <div class="histo-tl-desc @(esNotaClinica || esNotaRecep ? "histo-tl-desc-nota" : "")">@ev.Descripcion</div>
                        }
                        @if (esOdonto && ev.Id > 0)
                        {
                            <a asp-action="VerEvento" asp-route-id="@ev.Id" asp-route-pacienteId="@Model!.PacienteId" class="histo-tl-action">Ver detalle</a>
                        }
                        else if (!esNotaClinica && !esNotaRecep && ev.CitaId.HasValue)
                        {
                            <button type="button" class="histo-tl-action" onclick="abrirResumenCita(@ev.CitaId.Value)">Ver resumen</button>
                        }
                        else if (!esOdonto && !esNotaClinica && !esNotaRecep && ev.Id > 0)
                        {
                            <a asp-action="VerEvento" asp-route-id="@ev.Id" asp-route-pacienteId="@Model!.PacienteId" class="histo-tl-action">Ver evento</a>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="histo-tl-empty">No hay eventos en el historial.</div>
        }
    </div>
</div>

@* ─── Drawer: Resumen de cita ─── *@
<div class="cita-drawer-backdrop" id="citaBackdrop" onclick="cerrarDrawer()"></div>
<div class="cita-drawer" id="citaDrawer" role="dialog" aria-modal="true" aria-label="Resumen de cita">
    <div class="cita-drawer-head">
        <h2 class="cita-drawer-titulo">Resumen de cita</h2>
        <button type="button" class="cita-drawer-close" onclick="cerrarDrawer()" aria-label="Cerrar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>
    <div class="cita-drawer-body" id="citaDrawerBody">
        <div class="cita-drawer-loading">
            <div class="cita-drawer-spinner"></div>
            Cargando...
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const drawer   = document.getElementById('citaDrawer');
    const backdrop = document.getElementById('citaBackdrop');
    const body     = document.getElementById('citaDrawerBody');
    const urlBase  = '@Url.Action("ResumenCita", "Expediente", new { area = "Clinica" })';

    window.abrirResumenCita = async function (citaId) {
        body.innerHTML = '<div class="cita-drawer-loading"><div class="cita-drawer-spinner"></div>Cargando...</div>';
        drawer.classList.add('open');
        backdrop.classList.add('open');
        document.body.style.overflow = 'hidden';

        try {
            const res  = await fetch(urlBase + '?id=' + citaId);
            if (!res.ok) throw new Error('No encontrado');
            const d = await res.json();
            body.innerHTML = renderDrawer(d);
        } catch {
            body.innerHTML = '<div class="cita-drawer-loading">No se pudo cargar el resumen de la cita.</div>';
        }
    };

    window.cerrarDrawer = function () {
        drawer.classList.remove('open');
        backdrop.classList.remove('open');
        document.body.style.overflow = '';
    };

    document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrarDrawer(); });

    function fmt(n) {
        return 'RD$ ' + Number(n).toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function estadoClass(estado) {
        const e = (estado || '').toLowerCase();
        if (e === 'finalizada') return 'cita-estado-finalizada';
        if (e === 'cancelada')  return 'cita-estado-cancelada';
        if (e === 'noshow')     return 'cita-estado-noshow';
        return 'cita-estado-otra';
    }

    function renderDrawer(d) {
        const durStr = d.duracionMin != null ? d.duracionMin + ' min' : '—';

        // ── Info header ──
        let html = `
        <div class="cita-drawer-info">
            <div>
                <div class="cita-drawer-label">Fecha</div>
                <div class="cita-drawer-value">${d.fecha}</div>
            </div>
            <div>
                <div class="cita-drawer-label">Estado</div>
                <div class="cita-drawer-value"><span class="${estadoClass(d.estado)}">${d.estado}</span></div>
            </div>
            <div>
                <div class="cita-drawer-label">Doctor</div>
                <div class="cita-drawer-value">${d.doctorNombre}</div>
            </div>
            <div>
                <div class="cita-drawer-label">Duración</div>
                <div class="cita-drawer-value">${durStr}</div>
            </div>
            <div class="cita-drawer-info-full">
                <div class="cita-drawer-label">Motivo</div>
                <div class="cita-drawer-value">${d.motivo}</div>
            </div>
        </div>`;

        // ── Procedimientos ──
        html += `<div class="cita-drawer-section-title">Procedimientos</div>`;
        if (d.procedimientos && d.procedimientos.length > 0) {
            html += `<div class="cita-proc-list">`;
            for (const pr of d.procedimientos) {
                const doneClass = pr.realizado ? 'cita-proc-item-done' : '';
                const checkSvg  = pr.realizado
                    ? `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>`
                    : '';
                const precioClass = pr.precio > 0 ? 'cita-proc-precio' : 'cita-proc-precio cita-proc-precio-zero';
                const precioStr   = pr.precio > 0 ? fmt(pr.precio) : '—';
                html += `
                <div class="cita-proc-item ${doneClass}">
                    <div class="cita-proc-check">${checkSvg}</div>
                    <div class="cita-proc-body">
                        <div class="cita-proc-nombre">${pr.nombre}</div>
                        ${pr.notas ? `<div class="cita-proc-notas">${pr.notas}</div>` : ''}
                    </div>
                    <div class="${precioClass}">${precioStr}</div>
                </div>`;
            }
            html += `</div>`;

            // Total
            if (d.totalCobrado > 0) {
                html += `
                <div class="cita-total-row">
                    <span class="cita-total-label">Total cobrado</span>
                    <span class="cita-total-valor">${fmt(d.totalCobrado)}</span>
                </div>`;
            }
        } else {
            html += `<p class="cita-drawer-empty">Sin procedimientos registrados.</p>`;
        }

        // ── Eventos / notas de esta cita ──
        if (d.eventos && d.eventos.length > 0) {
            html += `<div class="cita-drawer-section-title" style="margin-top:.75rem;">Notas de la sesión</div>`;
            html += `<div class="cita-eventos-list">`;
            for (const ev of d.eventos) {
                html += `
                <div class="cita-evento-item">
                    <span class="cita-evento-hora">${ev.hora}</span>
                    <div><span class="cita-evento-tipo">${ev.tipo}</span>${ev.descripcion ? ' — ' + ev.descripcion : ''}</div>
                </div>`;
            }
            html += `</div>`;
        }

        return html;
    }
})();
</script>
}
