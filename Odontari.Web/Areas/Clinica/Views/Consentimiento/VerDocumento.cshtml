@model Odontari.Web.Models.ConsentimientoGenerado
@using Odontari.Web.Models.Enums
@{
    ViewData["Title"] = "Documento firmado";
}
@section Styles {
    <link rel="stylesheet" href="~/css/consentimiento.css" asp-append-version="true" />
}

<div class="consent-page">
    <div class="d-flex align-items-center gap-3 mb-3">
        <a asp-action="Expediente" asp-controller="Atencion" asp-route-id="@Model.CitaId" class="odon-form-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Volver a cita
        </a>
        @if (Model.Estado == EstadoConsentimiento.Firmado)
        {
            <span class="consent-signed-badge mb-0">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                Documento firmado
            </span>
        }
    </div>

    <div class="consent-doc-card">
        <div class="consent-doc-header">
            @if (!string.IsNullOrEmpty(Model.Clinica?.LogoUrl))
            {
                <img src="@Model.Clinica.LogoUrl" alt="Logo" class="consent-doc-logo" />
            }
            else
            {
                <div class="consent-doc-logo-placeholder">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.7)" stroke-width="1.75"><path d="M12 2C9 2 6 4 6 7c0 1.5.4 3 .8 4.5C7.5 14 8 17 8 19c0 1.7 1.3 3 3 3 .8 0 1-.5 1-1.5V19c0-.6.4-1 1-1s1 .4 1 1v1.5c0 1 .2 1.5 1 1.5 1.7 0 3-1.3 3-3 0-2-.5-5-1.2-7.5C17.6 10 18 8.5 18 7c0-3-3-5-6-5z"/></svg>
                </div>
            }
            <div>
                <div class="consent-doc-clinic">@Model.Clinica?.Nombre</div>
                <h2 class="consent-doc-title">@Model.Plantilla?.Titulo</h2>
            </div>
        </div>
        <div class="consent-doc-meta">
            <div class="consent-meta-item">
                <span class="consent-meta-label">Paciente</span>
                <span class="consent-meta-value">@Model.Paciente?.Nombre @Model.Paciente?.Apellidos</span>
            </div>
            <div class="consent-meta-item">
                <span class="consent-meta-label">Doctor</span>
                <span class="consent-meta-value">@(Model.Doctor?.NombreCompleto ?? Model.Doctor?.Email ?? "—")</span>
            </div>
            <div class="consent-meta-item">
                <span class="consent-meta-label">Firmante</span>
                <span class="consent-meta-value">@(Model.NombreFirmante ?? "—")</span>
            </div>
            <div class="consent-meta-item">
                <span class="consent-meta-label">Generado</span>
                <span class="consent-meta-value">@Model.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            @if (Model.FechaFirma.HasValue)
            {
                <div class="consent-meta-item">
                    <span class="consent-meta-label">Firmado</span>
                    <span class="consent-meta-value">@Model.FechaFirma.Value.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            }
            <div class="consent-meta-item">
                <span class="consent-meta-label">Versión plantilla</span>
                <span class="consent-meta-value">v@Model.VersionPlantilla</span>
            </div>
        </div>
        <div class="consent-doc-body">
            <div class="consent-doc-text">@Model.TextoFinal</div>

            @if (!string.IsNullOrEmpty(Model.FirmaDigitalBase64))
            {
                <hr class="my-3" />
                <div class="consent-meta-label mb-2">Firma digital capturada</div>
                <div class="consent-firma-img-wrap">
                    <img src="@Model.FirmaDigitalBase64" alt="Firma digital" />
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Observacion))
            {
                <hr class="my-3" />
                <div class="consent-meta-label mb-1">Observación</div>
                <p class="small text-muted">@Model.Observacion</p>
            }
        </div>
    </div>
</div>
