@model PagoRegistroViewModel
@{
    var orden = ViewBag.Orden as Odontari.Web.Models.OrdenCobro;
    var procedimientos = ViewBag.Procedimientos as List<(string Nombre, string? Notas, decimal Precio)> ?? new List<(string, string?, decimal)>();
    var totalProcedimientos = ViewBag.TotalProcedimientos as decimal? ?? orden?.Total ?? 0;
    ViewData["Title"] = "Registrar pago";
}
@section Styles {
    <link rel="stylesheet" href="~/css/clinica-content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/caja-cobrar.css" asp-append-version="true" />
}

<div class="odon-form-page odon-form-page-wide">
    <div class="odon-form-card">
        <div class="odon-form-header">
            <a asp-action="Index" class="odon-form-back">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                Volver a Caja
            </a>
            <h1 class="odon-form-title">Registrar pago</h1>
        </div>

        <div class="odon-form-body">
            @if (orden != null)
            {
                <span class="odon-section-label">Resumen de la orden</span>
                <div class="cobrar-resumen-grid">
                    <div class="cobrar-resumen-item-new">
                        <span class="odon-label">Paciente</span>
                        <span class="cobrar-resumen-valor">@orden.Paciente?.Nombre @orden.Paciente?.Apellidos</span>
                    </div>
                    <div class="cobrar-resumen-item-new">
                        <span class="odon-label">Total orden</span>
                        <span class="cobrar-resumen-valor">RD$ @orden.Total.ToString("N2")</span>
                    </div>
                    <div class="cobrar-resumen-item-new">
                        <span class="odon-label">Ya pagado</span>
                        <span class="cobrar-resumen-valor">RD$ @orden.MontoPagado.ToString("N2")</span>
                    </div>
                    <div class="cobrar-resumen-item-new cobrar-saldo-highlight">
                        <span class="odon-label">Saldo pendiente</span>
                        <span class="cobrar-resumen-valor cobrar-saldo-valor">RD$ @Model.SaldoPendiente.ToString("N2")</span>
                    </div>
                </div>
            }

            @if (procedimientos.Any())
            {
                <span class="odon-section-label" style="margin-top:1.25rem">Procedimientos</span>
                <table class="cobrar-procedimientos-table">
                    <thead>
                        <tr>
                            <th>Tratamiento</th>
                            <th class="cobrar-procedimientos-th-precio">Precio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in procedimientos)
                        {
                            <tr>
                                <td>@p.Nombre @if (!string.IsNullOrEmpty(p.Notas)) { <span class="cobrar-procedimientos-notas">(@p.Notas)</span> }</td>
                                <td class="cobrar-procedimientos-precio">RD$ @p.Precio.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="cobrar-procedimientos-total-row">
                            <td><strong>Total</strong></td>
                            <td class="cobrar-procedimientos-precio"><strong>RD$ @totalProcedimientos.ToString("N2")</strong></td>
                        </tr>
                    </tfoot>
                </table>
            }
            else if (orden != null)
            {
                <p class="cobrar-procedimientos-empty">No hay detalle de procedimientos. Total de la orden: <strong>RD$ @orden.Total.ToString("N2")</strong></p>
            }

            <span class="odon-section-label" style="margin-top:1.25rem">Datos del pago</span>
            <form asp-action="Cobrar" asp-route-id="@Model.OrdenCobroId" method="post">
                <input type="hidden" asp-for="OrdenCobroId" />
                <input type="hidden" asp-for="SaldoPendiente" />

                <div class="odon-form-row">
                    <div class="odon-form-field">
                        <label class="odon-label" asp-for="Monto">Monto (RD$)</label>
                        <input asp-for="Monto" type="number" step="0.01" min="0" class="odon-input" placeholder="0.00" />
                        <span asp-validation-for="Monto" class="text-danger small"></span>
                    </div>
                    <div class="odon-form-field">
                        <label class="odon-label" asp-for="MetodoPago">Método de pago</label>
                        <select asp-for="MetodoPago" class="odon-select">
                            <option value="">-- Seleccionar --</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Tarjeta">Tarjeta</option>
                            <option value="Crédito">Crédito</option>
                            <option value="Mixto">Mixto</option>
                        </select>
                    </div>
                </div>
                <div class="odon-form-field" style="margin-top:.75rem">
                    <label class="odon-label" asp-for="Referencia">Referencia</label>
                    <input asp-for="Referencia" class="odon-input" placeholder="Nº de referencia o nota" />
                </div>

                <div class="odon-form-footer" style="position:static;border-top:1px solid #edf0f4;margin:1.5rem -2rem -1.75rem;padding:1rem 2rem">
                    <a asp-action="Index" class="odon-btn odon-btn-secondary">Cancelar</a>
                    <button type="submit" class="odon-btn odon-btn-primary">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                        Registrar pago
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
